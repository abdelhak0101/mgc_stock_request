<odoo>
    <record id="view_product_template_form_inherit_hide_header" model="ir.ui.view">
        <field name="name">product.template.form.hide.header.for.stock.user</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">

            <xpath expr="//div[@name='button_box']" position="attributes">
                <attribute name="groups">stock.group_stock_manager</attribute>
            </xpath>

            <!-- Add a new button box ONLY for stock_request.group_stock_request_user -->
            <xpath expr="//div[@name='button_box']" position="after">
                <div class="oe_button_box"
                     groups="stock_request.group_stock_request_user,!stock.group_stock_manager">

                    <button name="action_open_allowed_quants"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-cubes"
                            string="My Stock"/>

                </div>
            </xpath>

        </field>
    </record>

    <record id="view_product_template_list_inherit" model="ir.ui.view">
        <field name="name">product.template.list.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <!-- Hide standard qty_available for non-managers -->
            <xpath expr="//field[@name='qty_available']" position="attributes">
                <attribute name="groups">stock.group_stock_manager</attribute>
            </xpath>
            <xpath expr="//field[@name='virtual_available']" position="attributes">
                <attribute name="groups">stock.group_stock_manager</attribute>
            </xpath>
        </field>
    </record>


    <record id="product_template_kanban_allowed_qty" model="ir.ui.view">
        <field name="name">product.template.kanban.allowed_qty</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_kanban_view"/>
        <field name="arch" type="xml">
            <!-- Replace qty_available with allowed_qty -->
            <xpath expr="//field[@name='qty_available']" position="replace">
                <field name="allowed_qty"/>
            </xpath>
        </field>
    </record>


    <record id="view_stock_quant_form_inherit" model="ir.ui.view">
        <field name="name">viw.stock.quant.form.inherit</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_id']" position="attributes">
                <attribute name="groups">stock.group_stock_manager</attribute>
            </xpath>
        </field>
    </record>

</odoo>
