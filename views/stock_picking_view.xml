<odoo>
    <record id="view_stock_picking_form_inherit_button_validate" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.button.validate</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">

            <xpath expr="//button[@name='button_validate']" position="attributes">
                <attribute name="groups">stock.group_stock_manager</attribute>
            </xpath>

            <xpath expr="//header" position="inside">

                <button name="%(stock.action_report_picking)d"
                        type="action"
                        string="Print"
                        attrs="{'invisible': [('picking_type_code', '!=', 'incoming')]}"/>

            </xpath>


            <xpath expr="//button[@name='do_print_picking']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@name='175']" position="attributes">
                <attribute name="attrs">{'invisible': [('picking_type_code', '=', 'incoming')]}</attribute>
            </xpath>

            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//div[@class='o_td_label']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='location_dest_id']" position="attributes">
                <attribute name="attrs">{'invisible': [('picking_type_code', '=', 'incoming')]}</attribute>
            </xpath>

            <xpath expr="//field[@name='origin']" position="after">
                <field name="p_service" attrs="{'invisible': [('picking_type_code', '!=', 'outgoing')]}"/>
            </xpath>

            <xpath expr="//field[@name='picking_type_id']" position="before">
                <field name="supp_name" groups="stock.group_stock_manager"/>
            </xpath>

            <xpath expr="//field[@name='partner_id']" position="after">

                <div class="o_td_label">
                    <!-- Receipt -->
                    <label for="num_of_order"
                           string="Receipt Order Number"
                           attrs="{'invisible': [('picking_type_code', '!=', 'incoming')]}"/>

                    <!-- Delivery -->
                    <label for="num_of_order"
                           string="Delivery Order Number"
                           attrs="{'invisible': [('picking_type_code', '!=', 'outgoing')]}"/>
                </div>

                <field name="num_of_order" nolabel="1"/>

            </xpath>
        </field>
    </record>
    <record id="stock.action_report_delivery" model="ir.actions.report">
        <field name="binding_model_id" eval="False"/>
    </record>
    <record id="stock.action_label_transfer_template_zpl" model="ir.actions.report">
        <field name="binding_model_id" eval="False"/>
    </record>
    <record id="stock.action_label_transfer_template_pdf" model="ir.actions.report">
        <field name="binding_model_id" eval="False"/>
    </record>
    <record id="stock.action_report_picking" model="ir.actions.report">
        <field name="binding_model_id" eval="False"/>
    </record>

    <record id="view_stock_picking_tree_inherit" model="ir.ui.view">
        <field name="name">stock.picking.tree.inherit</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="before">
                <field name="p_service"/>
            </xpath>
        </field>
    </record>

</odoo>